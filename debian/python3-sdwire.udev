# rules for SDWire3
SUBSYSTEM=="usb", ATTRS{idVendor}=="0bda", ATTRS{idProduct}=="0316", MODE="0666", GROUP="plugdev"

# rules for SDWireC and Legacy Tizen SDWire
SUBSYSTEM=="usb", ATTRS{idVendor}=="04e8", ATTRS{idProduct}=="6001", MODE="0666", GROUP="plugdev"

